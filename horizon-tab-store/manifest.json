{
  "manifest_version": 3,
  "name": "Horizon Tab",
  "version": "1.16.2",
  "description": "A minimal, beautiful, customizable new tab page — your horizon, your way.",
  "chrome_url_overrides": {
    "newtab": "tab.html"
  },
  "permissions": [
    "storage",
    "search"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "horizon-tab@rishvanthamsaraj",
      "strict_min_version": "128.0"
    }
  }
}
