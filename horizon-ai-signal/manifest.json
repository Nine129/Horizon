{
  "manifest_version": 3,
  "name": "Horizon AI Signal",
  "short_name": "AI Signal",
  "version": "1.0.0",
  "description": "Detect AI-generated text on search results and web pages — a private, on-device heuristic.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "host_permissions": [
    "*://safebrowsing.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/search*",
        "*://*.duckduckgo.com/*",
        "*://search.brave.com/search*"
      ],
      "js": [
        "score.js",
        "content.js"
      ],
      "css": [
        "badge.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "AI Signal settings"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
